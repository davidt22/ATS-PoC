{% extends 'base.html.twig' %}

{% block title %}Candidaturas — ATS PoC{% endblock %}

{% block body %}
    <div class="card" {{ stimulus_controller('applications-list') }}>
        <h1>Candidaturas</h1>

        <div class="filters">
            <input type="text" placeholder="Buscar por nombre o email…"
                {{ stimulus_target('applications-list', 'search') }}
                {{ stimulus_action('applications-list', 'onSearchInput', 'input') }}>
            <select
                {{ stimulus_target('applications-list', 'status') }}
                {{ stimulus_action('applications-list', 'load', 'change') }}>
                <option value="">Todos los estados</option>
                <option value="received">Recibida</option>
                <option value="enriched">Enriquecida</option>
            </select>
            <select
                {{ stimulus_target('applications-list', 'job') }}
                {{ stimulus_action('applications-list', 'load', 'change') }}>
                <option value="">Todos los puestos</option>
                {% for job in jobPostings %}
                    <option value="{{ job.id }}">{{ job.title }}</option>
                {% endfor %}
            </select>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Candidato</th>
                    <th>Oferta</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th>Puntuación IA</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody {{ stimulus_target('applications-list', 'body') }}>
                <tr><td colspan="7" class="empty-state">Cargando…</td></tr>
            </tbody>
        </table>
    </div>
{% endblock %}
