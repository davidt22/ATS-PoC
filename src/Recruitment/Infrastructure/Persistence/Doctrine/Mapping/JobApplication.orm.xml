<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                       https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Recruitment\Domain\Model\JobApplication" table="job_applications">
        <id name="id" type="recruitment_uuid" column="id" length="36">
            <generator strategy="NONE"/>
        </id>

        <field name="jobId" type="recruitment_uuid" column="job_id" length="36"/>
        <field name="fullName" type="recruitment_full_name" column="full_name" length="150"/>
        <field name="email" type="recruitment_email" column="email" length="180"/>
        <field name="phone" type="recruitment_phone" column="phone" length="20" nullable="true"/>
        <field name="notes" type="text" column="notes" nullable="true"/>
        <field name="cvText" type="recruitment_cv_text" column="cv_text"/>
        <field name="appliedAt" type="datetime_immutable" column="applied_at"/>
        <field name="status" type="string" column="status" length="20" enum-type="App\Recruitment\Domain\ValueObject\ApplicationStatus"/>
        <field name="aiSummary" type="text" column="ai_summary" nullable="true"/>
        <field name="aiScore" type="recruitment_ai_score" column="ai_score" nullable="true"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>

        <indexes>
            <index name="idx_job_applications_status" columns="status"/>
            <index name="idx_job_applications_job_id" columns="job_id"/>
            <index name="idx_job_applications_applied_at" columns="applied_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
